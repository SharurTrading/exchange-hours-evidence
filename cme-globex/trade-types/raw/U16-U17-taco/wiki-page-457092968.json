s/EPICSANDBOX/overview","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457314687"}},{"id":"457315422","type":"page","ari":"ari:cloud:confluence:9041264b-18e1-49d1-aa92-7b0360160143:page/457315422","base64EncodedAri":"YXJpOmNsb3VkOmNvbmZsdWVuY2U6OTA0MTI2NGItMThlMS00OWQxLWFhOTItN2IwMzYwMTYwMTQzOmNvbnRlbnQvNDU3MzE1NDIy","status":"current","title":"CME Globex","macroRenderedOutput":{},"extensions":{"position":6921114},"_expandable":{"container":"/rest/api/space/EPICSANDBOX","metadata":"","restrictions":"/rest/api/content/457315422/restriction/byOperation","history":"/rest/api/content/457315422/history","body":"","version":"","descendants":"/rest/api/content/457315422/descendant","space":"/rest/api/space/EPICSANDBOX","childTypes":"","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/457315422/child","ancestors":"","draftVersion":""},"_links":{"self":"https://cmegroupclientsite.atlassian.net/wiki/rest/api/content/457315422","tinyui":"/x/XhRCGw","editui":"/pages/resumedraft.action?draftId=457315422","webui":"/spaces/EPICSANDBOX/pages/457315422/CME+Globex","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457315422"}},{"id":"457317350","type":"page","ari":"ari:cloud:confluence:9041264b-18e1-49d1-aa92-7b0360160143:page/457317350","base64EncodedAri":"YXJpOmNsb3VkOmNvbmZsdWVuY2U6OTA0MTI2NGItMThlMS00OWQxLWFhOTItN2IwMzYwMTYwMTQzOmNvbnRlbnQvNDU3MzE3MzUw","status":"current","title":"Product Specific Information","macroRenderedOutput":{},"extensions":{"position":213345705},"_expandable":{"container":"/rest/api/space/EPICSANDBOX","metadata":"","restrictions":"/rest/api/content/457317350/restriction/byOperation","history":"/rest/api/content/457317350/history","body":"","version":"","descendants":"/rest/api/content/457317350/descendant","space":"/rest/api/space/EPICSANDBOX","childTypes":"","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/457317350/child","ancestors":"","draftVersion":""},"_links":{"self":"https://cmegroupclientsite.atlassian.net/wiki/rest/api/content/457317350","tinyui":"/x/5htCGw","editui":"/pages/resumedraft.action?draftId=457317350","webui":"/spaces/EPICSANDBOX/pages/457317350/Product+Specific+Information","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457317350"}},{"id":"457220354","type":"page","ari":"ari:cloud:confluence:9041264b-18e1-49d1-aa92-7b0360160143:page/457220354","base64EncodedAri":"YXJpOmNsb3VkOmNvbmZsdWVuY2U6OTA0MTI2NGItMThlMS00OWQxLWFhOTItN2IwMzYwMTYwMTQzOmNvbnRlbnQvNDU3MjIwMzU0","status":"current","title":"Exceptional Trading Conventions","macroRenderedOutput":{},"extensions":{"position":5941},"_expandable":{"container":"/rest/api/space/EPICSANDBOX","metadata":"","restrictions":"/rest/api/content/457220354/restriction/byOperation","history":"/rest/api/content/457220354/history","body":"","version":"","descendants":"/rest/api/content/457220354/descendant","space":"/rest/api/space/EPICSANDBOX","childTypes":"","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/457220354/child","ancestors":"","draftVersion":""},"_links":{"self":"https://cmegroupclientsite.atlassian.net/wiki/rest/api/content/457220354","tinyui":"/x/AqFAGw","editui":"/pages/resumedraft.action?draftId=457220354","webui":"/spaces/EPICSANDBOX/pages/457220354/Exceptional+Trading+Conventions","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457220354"}}],"macroRenderedOutput":{},"body":{"view":{"value":"<p><br/></p><p><span class=\"legacy-color-text-default\">A Basis Trade at Cash Open (TACO) is an outright future trading the differential between the equity future and underlying cash index marking at the publication of the Special Opening Quotation (SOQ).</span></p><p><span class=\"legacy-color-text-default\">TACO uses the same quoting convention as BTIC (Basis Trade at Index Close), but uses the cash market open and trades Sunday thru Friday following a unique trading schedule.</span><br/></p><p>Due to the uniqueness of the TACO trading schedule, customers trading TACO using the same session to trade multiple products should be prepared to:</p><ul><li><p>manage Fill Notice Execution Reports with different trade dates</p></li><li><p>ensure correct trade date is selected in any User Interface (UIs), including CME Direct and CME FirmSoft.</p></li></ul><p><strong>Example:</strong> TACO Order/trades submitted Monday between 10:00 am - 8:30 am Tuesday would be considered a Tuesday trade date. Non TACO orders submitted Monday from 10 am - 4 pm would be considered a Monday trade date.  Customers using the same session to manage multiple products including TACO will need to select the <strong>correct trade date</strong> when using a UI to query orders/trades. </p><div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-name=\"info\" data-macro-id=\"a3033140-9149-4483-88a0-b8d40f1ccf79\"><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p>CME Group recommends customers thoroughly test this behavior in New Release</p></div></div><p>The settlement price in Market Data Incremental Refresh (tag 35-MsgType=<strong>X</strong>, 269=<strong>6</strong>) message is the price of the last traded differential of the trading session and is used for the following:</p><ul><li><p>internal Price Banding</p></li><li><p>display of reference price of the last traded differential on customer systems.</p></li></ul><div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-name=\"info\" data-macro-id=\"f656e92f-c564-4980-a762-9ff46300aba5\"><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p>Preliminary and final settlements will be published externally; these prices are not used for Clearing end of day mark to market, the Special Opening Quote (SOQ) for the TACO will be used by Clearing for mark to market purposes.</p></div></div><h1 id=\"BasisTradeatCashOpen-TACOTradingHoursforEquityContracts\">TACO Trading Hours for Equity Contracts</h1><p>Sunday – Friday as follows:</p><ul><li><p>Sunday Pre-Open 4:00 pm Central Time (CT)</p></li><li><p>Trading starts on Sunday at 5:00 pm (CT) and stops on Monday at 8:30 am (CT)</p></li><li><p>Monday – Friday trading stops and market close at 8:30 am (CT), ALL day orders eliminated</p></li><li><p>Monday – <span class=\"legacy-color-text-blue1\">Friday Pre-Open 9:30 am (CT)</span></p></li><li><p><span class=\"legacy-color-text-blue1\">Monday – Friday </span>trades from 10:00 am (CT) – 4:00 pm (CT)</p></li><li><p>Monday – Thursday Market Halt occurs at 4:00 pm – 5:00 pm (CT) - Globex Maintenance Period NO day orders eliminated</p></li><li><p>Monday – Thursday Pre-Open 4:45 pm (CT)</p></li><li><p>Monday – Thursday trades from 5:00 pm (CT) – 8:30 am (CT) next business day</p></li></ul><div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-name=\"info\" data-macro-id=\"c1a35d56-9a58-43f4-b279-a568394d3c2c\"><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p>Any order submitted on Friday after 10:00am (CT) will have a next business date of Monday.</p></div></div><ul><li><p>TACO markets do not and will not support GT orders.</p></li><li><p>Day/session orders entered on Friday for Monday’s trade date will be eliminated at the 1st close on Friday afternoon.</p></li><li><p>No TACO orders will be persisted over the weekend.</p></li><li><p>Clients must re-enter their Day/session orders for Monday trade date when we re-open Sunday for Monday’s trade date.</p></li></ul>","representation":"view","_expandable":{"webresource":"","embeddedContent":"","mediaToken":"","content":"/rest/api/content/457092968"}},"_expandable":{"editor":"","atlas_doc_format":"","export_view":"","styled_view":"","markdown":"","dynamic":"","storage":"","editor2":"","anonymous_export_view":""}},"extensions":{"position":336},"_expandable":{"childTypes":"","container":"/rest/api/space/EPICSANDBOX","schedulePublishInfo":"","metadata":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/457092968/child","restrictions":"/rest/api/content/457092968/restriction/byOperation","draftVersion":"","descendants":"/rest/api/content/457092968/descendant","space":"/rest/api/space/EPICSANDBOX"},"_links":{"editui":"/pages/resumedraft.action?draftId=457092968","webui":"/spaces/EPICSANDBOX/pages/457092968/Basis+Trade+at+Cash+Open","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457092968","context":"/wiki","self":"https://cmegroupclientsite.atlassian.net/wiki/rest/api/content/457092968","tinyui":"/x/aK8_Gw","collection":"/rest/api/content","base":"https://cmegroupclientsite.atlassian.net/wiki"}}