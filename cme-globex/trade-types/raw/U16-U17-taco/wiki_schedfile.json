yled_view":"","markdown":"","dynamic":"","editor2":"","anonymous_export_view":""}},"extensions":{"position":11840},"_expandable":{"container":"/rest/api/space/EPICSANDBOX","metadata":"","restrictions":"/rest/api/content/457704103/restriction/byOperation","history":"/rest/api/content/457704103/history","descendants":"/rest/api/content/457704103/descendant","space":"/rest/api/space/EPICSANDBOX","childTypes":"","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/457704103/child","ancestors":"","draftVersion":""},"_links":{"editui":"/pages/resumedraft.action?draftId=457704103","webui":"/spaces/EPICSANDBOX/pages/457704103/CME+Globex+Market+Schedule+File+Overview","edituiv2":"/spaces/EPICSANDBOX/pages/edit-v2/457704103","context":"/wiki","self":"https://cmegroupclientsite.atlassian.net/wiki/rest/api/content/457704103","tinyui":"/x/pwJIGw","collection":"/rest/api/content","base":"https://cmegroupclientsite.atlassian.net/wiki"}}