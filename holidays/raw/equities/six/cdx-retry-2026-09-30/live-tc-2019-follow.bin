              <tr v-if="!listOfNews.length">
                <td colspan="2" class="newsboard-teaser__no-results">
    
    No results
    
</td>
              </tr>
              <tr v-if="listOfNews.length" v-for="item in listOfNews" :key="item.no">
                <td class="newsboard-teaser__date-col">{{(item.date)}}</td>
                <td>
                  <a :href="item.newsboardDetailsPath" :target="openInNewTab ? '_blank' : '_self'" :rel="openInNewTab ? 'noopener noreferrer' : ''">{{item.title}}</a>
                  
                </td>
              </tr>
              </tbody>
            </table>
          </div>
        </div>
      </figure>
    </div>
  </div>

